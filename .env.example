# OpenAI API key for note categorization
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Secret for signing JWT auth tokens (change this to any long random string)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Path to SQLite database (default is fine)
DATABASE_PATH=./the-collective.db
